<svg width="700" height="160" viewBox="0 0 700 160" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6366f1"/>
      <stop offset="50%" stop-color="#a855f7"/>
      <stop offset="100%" stop-color="#ec4899"/>
    </linearGradient>

    <linearGradient id="glassGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.08"/>
    </linearGradient>

    <linearGradient id="shine" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0"/>
      <stop offset="50%" stop-color="#ffffff" stop-opacity="0.55"/>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
    </linearGradient>

    <filter id="blurMe" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="18"/>
    </filter>

    <filter id="dropShadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="6" stdDeviation="10" flood-color="#000000" flood-opacity="0.25"/>
    </filter>
  </defs>

  <rect width="700" height="160" fill="url(#bgGrad)"/>

  <circle cx="120" cy="40" r="70" fill="#ffffff" opacity="0.25" filter="url(#blurMe)"/>
  <circle cx="560" cy="130" r="90" fill="#ffffff" opacity="0.20" filter="url(#blurMe)"/>
  <circle cx="400" cy="20" r="60" fill="#fef08a" opacity="0.25" filter="url(#blurMe)"/>

  <rect x="20" y="20" width="660" height="120" rx="24"
        fill="url(#glassGrad)"
        stroke="#ffffff" stroke-opacity="0.5" stroke-width="1.5"
        filter="url(#dropShadow)"/>

  <rect x="20" y="20" width="660" height="40" rx="24" fill="url(#shine)" opacity="0.6"/>

  <text x="350" y="98" text-anchor="middle"
        font-family="Segoe UI, Helvetica, Arial, sans-serif"
        font-size="46" font-weight="700"
        fill="#ffffff" fill-opacity="0.95"
        style="paint-order: stroke; stroke: #ffffff; stroke-opacity: 0.15; stroke-width: 1px;">
    Ahmad PakMehr
  </text>
</svg>
